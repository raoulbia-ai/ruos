# ruOS kernel config fragment, merged on top of x86_64_defconfig.
# Target: QEMU/KVM x86_64 guest with virtio devices. Everything built in, no modules.

CONFIG_LOCALVERSION="-ruos"
CONFIG_DEFAULT_HOSTNAME="ruos"

# Boot from an initramfs we build ourselves; devtmpfs populates /dev.
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Virtio guest drivers
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y

# QEMU fw_cfg in sysfs: the host passes the API key in without baking it into the image.
CONFIG_FW_CFG_SYSFS=y
CONFIG_FW_CFG_SYSFS_CMDLINE=y

# Sandboxing primitives the agent service relies on (or will).
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y

# Serial console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
